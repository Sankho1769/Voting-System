sequenceDiagram
    autonumber
    actor User as Authenticated User
    participant UI as Browser
    participant Ctrl as Auth Controller
    participant AuthSvc as AuthService
    participant UserRepo as UserRepository
    participant DB as MariaDB / MySQL
    participant Session as Session Context

    User->>UI: Enter current temporary password + new personal password
    UI->>Ctrl: POST /change-password (current, new, confirm, CSRF)
    Ctrl->>AuthSvc: changePassword(userId, current, new, confirm)
    
    AuthSvc->>UserRepo: findById(userId)
    UserRepo->>DB: SELECT * FROM users WHERE id = ?
    DB-->>UserRepo: Current user row
    
    alt Current password incorrect OR confirmation mismatch OR weak password
        AuthSvc-->>Ctrl: Specific validation error
        Ctrl-->>UI: Display error message
    else Valid New Password
        AuthSvc->>AuthSvc: password_hash(newPassword, PASSWORD_DEFAULT)
        AuthSvc->>UserRepo: updatePassword(userId, newHash)
        UserRepo->>DB: UPDATE users SET password_hash = ?, must_change_password = 0, auth_version = auth_version + 1 WHERE id = ?
        DB-->>UserRepo: Affected rows > 0
        
        AuthSvc->>Session: Refresh user session with new auth_version & must_change_password=0
        AuthSvc-->>Ctrl: Success
        Ctrl-->>UI: Redirect to / (Role Dashboard)
    end
